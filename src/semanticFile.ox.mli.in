@@ portable
type t
exception Invalid of string
type writer
val prepare_writer : ?check_cancel:(unit -> unit) -> Unix.file_descr -> writer
(** Borrow a private, singly linked regular output. Does not duplicate, close
    or own its FD. Keep the FD live and its flags stable, with exclusive output
    access, until the writer is retired. POSIX admission also rejects read-only
    and append-mode descriptors. On Windows, only kind/link checks are added to
    the existing seek/write backend; no new native Windows guarantee is made.
    EINTR admission retries check cancellation. Prepare even for an unchanged
    plan. No mount, immutable-content or hostile flag-mutation proof. *)
val write_at : writer -> string -> int -> int -> int64 -> int
(** One bounded write attempt, at most 64 KiB; checked slice and absolute offset.
    POSIX uses native pwrite without changing the shared file position. Input is
    copied into native stack storage before runtime release. Windows retains
    seek/write, which changes that position. The caller owns short-write/EINTR /
    cancellation looping; operational failures never select another backend.
    Input strings must remain immutable during the call. Neither entire-file
    inspection nor materialization is promised to preserve FD positions. *)
val with_fd : ?check_cancel:(unit -> unit) -> Unix.file_descr -> (t -> 'a) -> 'a
(** Duplicates a caller-owned regular descriptor. Use only in one worker;
    the duplicate shares its file position with the original descriptor.
    The optional worker-local cancellation check runs before opening, reading,
    each 64 KiB iteration, and final stability checks. *)
val with_borrowed_fd : ?check_cancel:(unit -> unit) -> Unix.file_descr -> (t -> 'a) -> 'a
(** POSIX bounded positional reader borrowing the caller's descriptor. No opens,
    duplicates, closes or shared-position changes, including error/cancellation.
    Caller keeps the regular readable FD alive, immutable and unreassigned until
    callback retirement; reader operations expire afterwards. Native reads use
    at most64KiB per attempt with checked offsets, short-read/EINTR cancellation
    loops and final stability checks. Windows explicitly refuses, no hidden
    descriptor-owning fallback. Not hostile-writer exclusion or mount proof. *)
type stage = Hash | Parse | Verify | Write
type stage_sample = { stage : stage; calls : int; inclusive_seconds : float }
type read_stats = { logical_bytes : int64; chunks : int64; saturated : bool;
                    stages : stage_sample list option }
val measure : t -> stage -> (unit -> 'a) -> 'a
(** Worker-local inclusive interval when stage measurement is enabled on this
    reader. Nested intervals overlap; never sum phases as operation wall time.
    A failed callback propagates unchanged and records no successful interval.
    Disabled readers call the callback without clock reads or counter updates. *)
val with_read_stats : ?measure_stages:bool -> ?check_cancel:(unit -> unit) -> Unix.file_descr ->
  (t -> 'a) -> 'a * read_stats
(** Opt-in accounting for a successfully completed, stability-checked reader.
    Counts bytes delivered by nonempty [read] and 64 KiB [iter] chunks, including
    repeated ranges and [digest]. Excludes channel prefetch, failed/partial reads,
    seeks/stats, writes, other readers and physical I/O. Callback/read/stability
    failure returns no report. Counters saturate rather than fail the operation;
    [saturated] makes an exact-total claim unavailable. Ordinary [with_fd] does
    not allocate/update counters. Worker-local state, no shared/global metrics.
    Optional [measure_stages] defaults false. [stages=None] means disabled or
    unavailable/invalid clock/counter; [Some []] means enabled, no measured
    phases. CLOCK_MONOTONIC on POSIX, unavailable on Windows. Only successful
    intervals are retained; reader/callback/stability failure returns no report.
    Includes scheduling and I/O, not isolated CPU or a hard resource bound. *)
val size : t -> int64
val check : t -> unit
val same_inode : t -> Unix.file_descr -> bool
val read : t -> int64 -> int -> string
(** Checked, exact read, at most 1 MiB per call. *)
val iter : t -> int64 -> int64 -> (bytes -> int -> unit) -> unit
val digest : t -> string
